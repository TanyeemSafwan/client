# Server-side only (used by next.config.ts rewrites and src/proxy.ts).
# Do NOT prefix these with NEXT_PUBLIC_ — they must never reach the browser.

# Express API base URL (Render URL in production)
API_URL=http://localhost:4000

# Must be identical to server JWT_SECRET (used to verify the cookie in proxy.ts)
JWT_SECRET=same-value-as-server-JWT_SECRET
COOKIE_NAME=dt_token
